# Copy to .env and fill in. The server won't start unless both services accept these.

# RS.ge service user (სერვისის მომხმარებელი), created on eservices.rs.ge: "name:taxcode" (taxcode 9 or 11 digits)
RS_SERVICE_USER=
RS_SERVICE_PASSWORD=

# smsoffice.ge API key (profile → integration) and the sender name registered there
# (at most 11 Latin letters, digits, "-" or ".")
SMSOFFICE_API_KEY=
SMSOFFICE_SENDER=

# Hosting (Vercel, Docker): the database, PostgreSQL or MariaDB. Empty = a SQLite file at server/data/hc.db.
# On Vercel the Neon integration sets it for you. See DEPLOY.md.
# DATABASE_URL=postgres://user:password@host/db
# DATABASE_URL=mysql://user:password@host:3306/db
# Lets GET /api/cron run the scheduled pass (Vercel Cron sends it as "Authorization: Bearer …").
# Any random string of 16+ characters.
# CRON_SECRET=

# The scale (სასწორი), see docs/scale-api.md. Each scale's ID and API address are set in the app
# (ცნობარები → სასწორი) and each route picks one. A shipment is sent with its estimated weight once
# RS.ge numbers the waybill; the scale posts the real weight back to /api/scale/weight, signed with the
# three SCALE_CALLBACK_* values: they must equal the scale's SAP:API:Auth:User, SAP:API:Auth:Pass and
# SAP:API:Secret (Integration.dll.config).
# SCALE_CALLBACK_USER=
# SCALE_CALLBACK_PASSWORD=
# SCALE_CALLBACK_SECRET=
# The scale's transport code for our trucks (default T00002: a truck outside its logistics fleet).
# SCALE_TRUCK_CODE=T00002

# Optional
# Active waybills are completed (დასრულებული) on their own this long after transport starts, as H:MM
# (hours:minutes, e.g. 8:30). 0:00 = as soon as it is activated and the driver texted. Empty = never;
# then only an admin completes them.
# WAYBILL_AUTO_CLOSE=8:00
# SMS: "sms" (default) texts login codes and the drivers' waybill SMS; "console" prints every one of
# them in the server console instead and texts nothing (testing only: anyone who can read the server
# log can log in as anyone).
# LOGIN_CODES=sms
# RS_WAYBILL_URL=https://services.rs.ge/WayBillService/WayBillService.asmx
# SMSOFFICE_URL=https://smsoffice.ge
# PORT=8787
# HOST=0.0.0.0
