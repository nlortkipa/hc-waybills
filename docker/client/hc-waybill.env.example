# Copy this file to hc-waybill.env and fill it in. The app does not start unless the database
# connects and both RS.ge and smsoffice.ge accept these accounts.

# Your MariaDB database: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# "host.docker.internal" is this machine (where MariaDB runs). The tables are created on first start.
# A password with special characters (@ : / # ? %) must be URL-encoded: @ → %40, : → %3A, / → %2F, # → %23.
# Add ?ssl=true at the end if your MariaDB requires TLS.
DATABASE_URL=mysql://hc_waybill:CHANGE_ME@host.docker.internal:3306/hc_waybill

# RS.ge service user (სერვისის მომხმარებელი), created on eservices.rs.ge: "name:taxcode"
RS_SERVICE_USER=
RS_SERVICE_PASSWORD=

# smsoffice.ge API key (profile → integration) and the sender name registered there
SMSOFFICE_API_KEY=
SMSOFFICE_SENDER=

# Optional: active waybills are completed on their own this long after transport starts (H:MM).
# Empty = never (only an admin completes them).
# WAYBILL_AUTO_CLOSE=8:00
