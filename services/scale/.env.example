# Copy to services/scale/.env (git-ignored) and fill in.

# Folder the client sent (contains Web.API.dll and DBi/*.mdf). Never committed.
SCALE_VENDOR_DIR=/path/to/Service

# Name the vendor .mdf is attached under. Matches the API's original config.
SCALE_DB_NAME=HCG-SCALES

# SQL Server needs 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=change-Me-123!
SCALE_API_DB_PASSWORD=change-Me-456!
INSPECTOR_DB_PASSWORD=change-Me-789!

# JWT signing key for the scale API (HS256/HS512 needs 64+ bytes).
SCALE_JWT_KEY=replace-with-a-long-random-string-replace-with-a-long-random-string

# Development enables Swagger at http://localhost:5080/swagger
SCALE_API_ENVIRONMENT=Development

SCALE_API_PORT=5080
SCALE_INSPECTOR_PORT=5081
SCALE_DB_PORT=14330

# Seller company sent with every weighing (must exist in Companies.Code).
# 230866435 = შპს ქართული ცემენტი, owner of factory 13; used by recent real waybills.
SCALE_SELLER_COMPANY_CODE=230866435
