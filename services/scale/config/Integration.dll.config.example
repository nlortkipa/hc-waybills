    <add key="GPSControl:API:URL:Edit" value="http://localhost/GPS/index.aspx" />
    <add key="GPSControl:API:URL:Delete" value="http://localhost/GPS/index.aspx" />
    <add key="SAP:API:Auth:User" value="" />
    <add key="SAP:API:Auth:Pass" value="" />
    <add key="SAP:API:URL:Output" value="" />
    <add key="SAP:API:Secret" value="" />
  </appSettings>
</configuration>
